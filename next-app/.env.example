# Copy to .env.local for local dev, and set these in the app.captainsbridge.io deploy.

# Clerk publishable key (public). Prod = pk_live_..., dev = pk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsuY2FwdGFpbnNicmlkZ2UuaW8k

# Clerk secret key (server only) — same value already set on the Express deploy (Railway).
CLERK_SECRET_KEY=sk_live_xxx

# Where API calls go: the existing Express backend on the main origin.
NEXT_PUBLIC_API_BASE=https://captainsbridge.io

# Existing Clerk hosted sign-in/up (the primary domain's account portal).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://accounts.captainsbridge.io/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://accounts.captainsbridge.io/sign-up

# NOTE: app.captainsbridge.io is a SUBDOMAIN of captainsbridge.io, so it shares
# the Clerk session by default — NO satellite domains (paid) needed. Just add
# app.captainsbridge.io to the Allowed Subdomains list in the Clerk dashboard
# (DNS & Domains). That is a free security allowlist.
