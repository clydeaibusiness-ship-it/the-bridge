  <script type="application/ld+json" is:inline>
  [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Earl",
      "description": "AI business mentor for small business owners. Earl learns your specific business through an interview, produces a personalized Navigation Chart, and holds your full context across six months of conversations.",
      "provider": { "@type": "Organization", "name": "Earl", "url": "https://captainsbridge.io" },
      "serviceType": "AI Business Mentorship",
      "audience": { "@type": "Audience", "audienceType": "Small business owners" }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "What is Earl?", "acceptedAnswer": { "@type": "Answer", "text": "Earl is an AI business mentor built from the collected wisdom of every serious book ever written about running and surviving a small business. He learns your specific business through an interview, produces a personalized Navigation Chart, and holds your full context in every conversation across six months." } },
        { "@type": "Question", "name": "How is Earl different from a business coach or consultant?", "acceptedAnswer": { "@type": "Answer", "text": "A business consultant typically costs $150 to $400 per session and forgets half of what you told them by the next meeting. Earl remembers everything from every conversation for six months, draws on real-world experience from every serious small business thinker who ever wrote about survival and growth, and is available whenever a decision needs to be made." } },
        { "@type": "Question", "name": "Who is Earl for?", "acceptedAnswer": { "@type": "Answer", "text": "Earl is for small business owners who are making the decisions that keep their business running and doing most of that thinking alone. Any industry, any stage, any definition of success." } },
        { "@type": "Question", "name": "How does Earl work?", "acceptedAnswer": { "@type": "Answer", "text": "Earl starts with an interview across three stages, about twenty-five minutes in total, covering your business, your goals, your numbers, and what you are trying to build. From those answers he produces your Navigation Chart, a strategic read of your specific situation. After that, every conversation draws on everything he learned about you." } }
      ]
    }
  ]
  </script>

