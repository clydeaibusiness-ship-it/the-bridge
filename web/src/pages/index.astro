<!-- FREE NEWSLETTER -->
<section class="bg-dark px-6 py-20" id="newsletter">
  <div class="mx-auto max-w-2xl text-center">
    <div class="mb-3 font-data text-[0.62rem] uppercase tracking-[0.18em] text-gold">Free newsletter</div>
    <h2 class="mb-3 text-fluid-xl font-bold text-bg">Not ready yet? Start here.</h2>
    <p class="mx-auto mb-6 max-w-xl text-fluid-base leading-relaxed text-[#a8a098]">Three mornings a week, Earl sends one thing from the world that affects whether your business survives it, one principle worth keeping from someone who has done this before, and one question to carry into your week. No politics, no noise, about a two-minute read, completely free.</p>
    <form class="flex flex-wrap justify-center gap-2" id="nl-form">
      <input class="min-w-[16rem] rounded-sm border border-[#4a4038] bg-[#2a2218] px-3.5 py-2.5 text-fluid-sm text-bg placeholder:text-[#6a6058] focus:border-gold focus:outline-none" id="nl-email" type="email" placeholder="you@business.com" required aria-label="Email address" />
      <button class="rounded-sm bg-gold px-6 py-2.5 font-data text-xs uppercase tracking-[0.08em] text-dark transition hover:bg-golddark" type="submit">Get it free</button>
    </form>
    <div class="mt-3 min-h-4 font-data text-xs text-gold" id="nl-msg"></div>
    <a class="mt-4 inline-block border-b border-[#4a4038] font-data text-xs tracking-[0.05em] text-[#a8a098] transition hover:text-bg" href="/newsletter">Read past issues first &rarr;</a>
  </div>
</section>

<!-- FOOTER -->
<footer class="bg-bg px-6 py-16" id="footer">
  <div class="mx-auto max-w-reading">
    <div class="space-y-4 text-fluid-base leading-relaxed text-ink/75">
      <p>The owners who come out the other side of this describe the same shift. They came in uncertain, drained, and out of answers. They came out knowing what to focus on, with energy they had forgotten they had, and with something that felt close to the freedom they originally started all of this for.</p>
      <p>That is what this is about. Not growth for its own sake. Not building toward an exit you never asked for. The life you had in mind when you first decided to do this on your own.</p>
      <div class="text-fluid-lg font-bold text-ink2">Earl has been waiting for you.</div>
    </div>

    <div class="mt-10 rounded-2xl border border-line bg-card p-6 text-center">
      <div class="mb-3 text-fluid-base font-semibold text-ink2">Know a business owner who needs this?</div>
      <button class="rounded-sm bg-gold px-6 py-3 font-data text-xs tracking-[0.08em] text-dark transition hover:bg-golddark" id="share-btn">Share this with someone who needs it</button>
      <div class="mt-3 text-fluid-sm text-ink/60">Send them this page. It costs nothing and it might change everything for them.</div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-line pt-6 font-data text-xs text-ink/50 sm:flex-row">
      <div>EARL 2025</div>
      <div class="flex gap-4">
        <a href="/newsletter" class="hover:text-ink2">Newsletter</a>
        <a href="#" class="hover:text-ink2">Privacy</a>
        <a href="/terms" class="hover:text-ink2">Terms</a>
        <a href="#" class="hover:text-ink2">Contact</a>
      </div>
    </div>
  </div>
</footer>

<script>
  // ---- Motion (respects prefers-reduced-motion via CSS) ----
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Kinetic headline: split into words, stagger them in on load.
  (function () {
    const h1 = document.querySelector('h1.kinetic');
    if (!h1 || reduce) { if (h1) h1.classList.add('loaded'); return; }
    const words = h1.textContent.trim().split(/\s+/);
    h1.innerHTML = words.map((w, i) => `<span class="word" style="transition-delay:${(i * 0.035).toFixed(3)}s">${w}</span>`).join(' ');
    requestAnimationFrame(() => requestAnimationFrame(() => h1.classList.add('loaded')));
    // Safety net: the headline must never stay invisible if rAF/transitions
    // are throttled — force the end state directly, not via the transition.
    setTimeout(() => {
      h1.classList.add('loaded');
      h1.querySelectorAll('.word').forEach(s => { s.style.transition = 'none'; s.style.opacity = '1'; s.style.transform = 'none'; });
    }, 1400);
  })();

  // Scroll reveals.
  (function () {
    const els = document.querySelectorAll('.reveal');
    if (reduce || !('IntersectionObserver' in window)) { els.forEach(el => el.classList.add('in')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    els.forEach(el => io.observe(el));
    // Safety net: never leave content hidden if the observer/transition misbehaves.
    setTimeout(() => els.forEach(el => { el.classList.add('in'); el.style.transition = 'none'; el.style.opacity = '1'; el.style.transform = 'none'; }), 4000);
  })();

  // Animated hero gradient (canvas 2D, CSS-blurred into a soft mesh).
  (function () {
    const c = document.getElementById('hero-canvas');
    if (!c || reduce) return;
    const ctx = c.getContext('2d');
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    function size() { c.width = Math.max(1, c.clientWidth * dpr); c.height = Math.max(1, c.clientHeight * dpr); }
    size(); window.addEventListener('resize', size);
    const stops = [
      { col: '#e8c78a', a: 0.95, x: 0.24, y: 0.30, ax: 0.14, ay: 0.10, sp: 1.0 },
      { col: '#e0a878', a: 0.80, x: 0.76, y: 0.34, ax: 0.12, ay: 0.13, sp: 0.8 },
      { col: '#cfe0c0', a: 0.65, x: 0.58, y: 0.76, ax: 0.13, ay: 0.10, sp: 1.2 },
      { col: '#f0d6b0', a: 0.85, x: 0.16, y: 0.80, ax: 0.10, ay: 0.09, sp: 0.9 },
    ];
    let t = 0, raf = null, vis = true;
    function frame() {
      if (!vis) { raf = null; return; }
      t += 0.006;
      const w = c.width, h = c.height, R = Math.max(w, h) * 0.55;
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = '#f5f0e8'; ctx.fillRect(0, 0, w, h);
      for (const s of stops) {
        const x = (s.x + Math.sin(t * s.sp) * s.ax) * w;
        const y = (s.y + Math.cos(t * s.sp * 0.9) * s.ay) * h;
        const g = ctx.createRadialGradient(x, y, 0, x, y, R);
        g.addColorStop(0, s.col); g.addColorStop(1, 'rgba(245,240,232,0)');
        ctx.globalAlpha = s.a; ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(frame);
    }
    // Pause when the hero scrolls out of view.
    const hero = document.getElementById('hero');
    if ('IntersectionObserver' in window && hero) {
      new IntersectionObserver((e) => {
        vis = e[0].isIntersecting;
        if (vis && !raf) frame();
      }, { threshold: 0 }).observe(hero);
    }
    frame();
  })();

  // Newsletter subscribe
  (function () {
    const f = document.getElementById('nl-form');
    if (!f) return;
    f.addEventListener('submit', async function (e) {
      e.preventDefault();
      const email = document.getElementById('nl-email').value, msg = document.getElementById('nl-msg');
      msg.textContent = '...';
      try {
        const r = await fetch('/api/newsletter/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: email }) });
        if (r.ok) { msg.textContent = 'You are on the list. Watch your inbox.'; f.reset(); }
        else { msg.textContent = 'Enter a valid email and try again.'; }
      } catch (_) { msg.textContent = 'Something went wrong, try again.'; }
    });
  })();

  // Auth-aware nav
  (async function checkAuth() {
    try {
      const resp = await fetch('/api/auth/me');
      if (resp.ok) {
        const data = await resp.json();
        if (data.id) {
          const link = document.getElementById('nav-auth-link');
          if (link) { link.textContent = 'Go to Earl'; link.href = '/dashboard'; }
        }
      }
    } catch (e) {}
  })();

  // Share button
  const shareBtn = document.getElementById('share-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText('https://captainsbridge.io'); }
      catch (e) {
        const ta = document.createElement('textarea');
        ta.value = 'https://captainsbridge.io';
        document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
      }
      const original = shareBtn.textContent;
      shareBtn.textContent = 'Link copied. Send it to someone who needs it.';
      setTimeout(() => { shareBtn.textContent = original; }, 3000);
    });
  }
</script>
</body>
</html>
