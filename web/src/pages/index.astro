<script>
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Kinetic headline: split into words, stagger them in on load.
  (function () {
    const h1 = document.querySelector('h1.kinetic');
    if (!h1 || reduce) { if (h1) h1.classList.add('loaded'); return; }
    const words = h1.textContent.trim().split(/\s+/);
    h1.innerHTML = words.map((w, i) => `<span class="word" style="transition-delay:${(i * 0.03).toFixed(3)}s">${w}</span>`).join(' ');
    requestAnimationFrame(() => requestAnimationFrame(() => h1.classList.add('loaded')));
    setTimeout(() => {
      h1.classList.add('loaded');
      h1.querySelectorAll('.word').forEach(s => { s.style.transition = 'none'; s.style.opacity = '1'; s.style.transform = 'none'; });
    }, 1400);
  })();

  // Scroll reveals.
  (function () {
    const els = document.querySelectorAll('.reveal');
    if (reduce || !('IntersectionObserver' in window)) { els.forEach(el => el.classList.add('in')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12 });
    els.forEach(el => io.observe(el));
    setTimeout(() => els.forEach(el => { el.classList.add('in'); el.style.transition = 'none'; el.style.opacity = '1'; el.style.transform = 'none'; }), 4000);
  })();

  // Animated hero gradient (canvas 2D, CSS-blurred into a soft warm mesh).
  (function () {
    const c = document.getElementById('hero-canvas');
    if (!c || reduce) return;
    const ctx = c.getContext('2d');
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    function size() { c.width = Math.max(1, c.clientWidth * dpr); c.height = Math.max(1, c.clientHeight * dpr); }
    size(); window.addEventListener('resize', size);
    const stops = [
      { col: '#e8b24e', a: 0.95, x: 0.20, y: 0.28, ax: 0.15, ay: 0.10, sp: 1.0 },
      { col: '#d97a4e', a: 0.85, x: 0.78, y: 0.30, ax: 0.13, ay: 0.14, sp: 0.8 },
      { col: '#e0955a', a: 0.80, x: 0.60, y: 0.78, ax: 0.14, ay: 0.11, sp: 1.2 },
      { col: '#d99a8a', a: 0.70, x: 0.14, y: 0.82, ax: 0.11, ay: 0.09, sp: 0.9 },
    ];
    let t = 0, raf = null, vis = true;
    function frame() {
      if (!vis) { raf = null; return; }
      t += 0.006;
      const w = c.width, h = c.height, R = Math.max(w, h) * 0.6;
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = '#f5f0e8'; ctx.fillRect(0, 0, w, h);
      for (const s of stops) {
        const x = (s.x + Math.sin(t * s.sp) * s.ax) * w;
        const y = (s.y + Math.cos(t * s.sp * 0.9) * s.ay) * h;
        const g = ctx.createRadialGradient(x, y, 0, x, y, R);
        g.addColorStop(0, s.col); g.addColorStop(1, 'rgba(245,240,232,0)');
        ctx.globalAlpha = s.a; ctx.fillStyle = g; ctx.fillRect(0, 0, w, h);
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(frame);
    }
    const hero = document.getElementById('hero');
    if ('IntersectionObserver' in window && hero) {
      new IntersectionObserver((e) => { vis = e[0].isIntersecting; if (vis && !raf) frame(); }, { threshold: 0 }).observe(hero);
    }
    frame();
  })();

  // Newsletter subscribe
  (function () {
    const f = document.getElementById('nl-form');
    if (!f) return;
    f.addEventListener('submit', async function (e) {
      e.preventDefault();
      const email = document.getElementById('nl-email').value, msg = document.getElementById('nl-msg');
      msg.textContent = '...';
      try {
        const r = await fetch('/api/newsletter/subscribe', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: email }) });
        if (r.ok) { msg.textContent = 'You are on the list. Watch your inbox.'; f.reset(); }
        else { msg.textContent = 'Enter a valid email and try again.'; }
      } catch (_) { msg.textContent = 'Something went wrong, try again.'; }
    });
  })();

  // Auth-aware nav
  (async function checkAuth() {
    try {
      const resp = await fetch('/api/auth/me');
      if (resp.ok) {
        const data = await resp.json();
        if (data.id) {
          const link = document.getElementById('nav-auth-link');
          if (link) { link.textContent = 'Go to Earl'; link.href = '/dashboard'; }
        }
      }
    } catch (e) {}
  })();

  // Share button
  const shareBtn = document.getElementById('share-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText('https://captainsbridge.io'); }
      catch (e) {
        const ta = document.createElement('textarea');
        ta.value = 'https://captainsbridge.io';
        document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
      }
      const original = shareBtn.textContent;
      shareBtn.textContent = 'Link copied. Send it to someone who needs it.';
      setTimeout(() => { shareBtn.textContent = original; }, 3000);
    });
  }
</script>
