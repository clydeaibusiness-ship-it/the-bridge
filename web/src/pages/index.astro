  <style is:global>
    /* Editorial display type on all headings (Playfair), body stays Epilogue. */
    h1, h2, h3, .display { font-family: 'Playfair Display', Georgia, serif; }
    h1, h2 { letter-spacing: -0.015em; }
    /* Animated hero gradient canvas, blurred so the 2D blobs read as a soft mesh. */
    #hero-canvas { position:absolute; inset:0; width:100%; height:100%; filter:blur(44px) saturate(1.35); opacity:1; z-index:0; }
    /* Marquee: duplicate the track and translate -50% for a seamless loop. */
    .marquee-mask { -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
    @media (prefers-reduced-motion: reduce) { .animate-marquee { animation: none !important; } }
    .kinetic .word { display:inline-block; opacity:0; transform:translateY(0.55em); transition:opacity .55s ease, transform .55s cubic-bezier(.2,.7,.2,1); }
    .kinetic.loaded .word { opacity:1; transform:none; }
    .reveal { opacity:0; transform:translateY(30px); transition:opacity .8s ease, transform .8s cubic-bezier(.2,.7,.2,1); }
    .reveal.in { opacity:1; transform:none; }
    @media (prefers-reduced-motion: reduce) {
      #hero-canvas { display:none; }
      .kinetic .word, .reveal { opacity:1 !important; transform:none !important; transition:none !important; }
